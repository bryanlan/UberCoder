{
  "version": 1,
  "sensitive_key": "(?:^|[_-])(?:authorization|api[_-]?key|password|passwd|secret|token|access[_-]?token|refresh[_-]?token|auth[_-]?token|private[_-]?key|client[_-]?secret)$",
  "rules": [
    {
      "pattern": "-----BEGIN [^-]*PRIVATE KEY-----.*?-----END [^-]*PRIVATE KEY-----",
      "flags": "is",
      "replacement": "[private key omitted]"
    },
    {
      "pattern": "\\b(?:postgres(?:ql)?|mysql|mariadb|sqlite|sqlserver|mssql|mongodb|redis|db)(?:\\+[a-z0-9_-]+)?://[^\\s\\\"'<>]+",
      "flags": "i",
      "replacement": "[database URL omitted]"
    },
    {
      "pattern": "\\b[a-z][a-z0-9+.-]{0,30}://[^\\s/@]+:[^\\s/@]+@[^\\s\\\"'<>]+",
      "flags": "i",
      "replacement": "[authenticated URL omitted]"
    },
    {
      "pattern": "^.*\\b[a-z0-9_-]*(?:authorization|api[_-]?key|password|passwd|secret|token|private[_-]?key)[\\\"']?\\s*[:=].*$",
      "flags": "im",
      "replacement": "[credential-bearing line omitted]"
    },
    {
      "pattern": "\\b(?:Bearer\\s+|sk-|gh[pousr]_|github_pat_)[A-Za-z0-9_./+=-]{16,}",
      "flags": "i",
      "replacement": "[credential omitted]"
    },
    {
      "pattern": "(?:[a-z]:[\\\\/]|/|\\.\\.?/)[^\\s\\\"'<>|]*\\.(?:sqlite3?|db)(?:-(?:wal|shm))?(?:\\?[^\\s\\\"'<>|]*)?",
      "flags": "i",
      "replacement": "[database path omitted]"
    }
  ],
  "cases": [
    {
      "input": "{\"RESEND_API_KEY\": \"sentinel_json_credential\"}",
      "expected": "[credential-bearing line omitted]"
    },
    {
      "input": "'CLIENT_SECRET': 'sentinel_quoted_secret'",
      "expected": "[credential-bearing line omitted]"
    },
    {
      "input": "RESEND_API_KEY=sentinel_env_credential",
      "expected": "[credential-bearing line omitted]"
    },
    {
      "input": "password = sentinel_password",
      "expected": "[credential-bearing line omitted]"
    },
    {
      "input": "postgresql://user:sentinel_url_password@private-host/secret_database",
      "expected": "[database URL omitted]"
    },
    {
      "input": "postgres://private-host/secret_database",
      "expected": "[database URL omitted]"
    },
    {
      "input": "mysql+pymysql://private-host/secret_database",
      "expected": "[database URL omitted]"
    },
    {
      "input": "sqlite:///private/state/secret.sqlite3",
      "expected": "[database URL omitted]"
    },
    {
      "input": "mongodb+srv://private-host/secret_database",
      "expected": "[database URL omitted]"
    },
    {
      "input": "https://user:sentinel_web_password@private-host/path",
      "expected": "[authenticated URL omitted]"
    },
    {
      "input": "failed opening /private/state/secret.sqlite3",
      "expected": "failed opening [database path omitted]"
    },
    {
      "input": "failed opening C:\\private\\state\\secret.db",
      "expected": "failed opening [database path omitted]"
    },
    {
      "input": "Bearer sentinel_long_bearer_credential",
      "expected": "[credential omitted]"
    },
    {
      "input": "ghp_sentinel_long_github_credential",
      "expected": "[credential omitted]"
    },
    {
      "input": "-----BEGIN PRIVATE KEY-----\nsentinel_private_key\n-----END PRIVATE KEY-----",
      "expected": "[private key omitted]"
    },
    {
      "input": "total_tokens: 4200; token_budget: 10000; cache_read_tokens: 300",
      "expected": "total_tokens: 4200; token_budget: 10000; cache_read_tokens: 300"
    },
    {
      "input": "Review /repo/worktree and https://docs.example.com/guide",
      "expected": "Review /repo/worktree and https://docs.example.com/guide"
    },
    {
      "input": "authorization=sentinel_auth_header",
      "expected": "[credential-bearing line omitted]"
    },
    {
      "input": "Bearer sentinel/long+bearer==credential",
      "expected": "[credential omitted]"
    }
  ]
}
