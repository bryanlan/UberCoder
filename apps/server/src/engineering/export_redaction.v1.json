  "entropy": {
    "pattern": "(?<![A-Za-z0-9_+/=-])[A-Za-z0-9_+/-]{32,}={0,2}(?![A-Za-z0-9_+/=-])",
    "minimum_bits_per_character": 3.5,
    "replacement": "[high-entropy value omitted]"
  },
  "max_export_text_length": 4096,
  "property_keys": [
    "PASSWORD",
    "PASSWD",
    "DB_PASSWORD",
    "API_KEY",
    "api-key",
    "RESEND_API_KEY",
    "AWS_SECRET_ACCESS_KEY",
