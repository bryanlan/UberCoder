{
  "server": {
    "host": "127.0.0.1",
    "port": 4317,
    "publicBaseUrl": "http://127.0.0.1:4317",
    "webDistPath": "/opt/agent-console/apps/web/dist"
  },
  "projectsRoot": "/srv/projects",
  "runtimeDir": "~/.local/share/agent-console/runtime",
  "databasePath": "~/.local/share/agent-console/agent-console.sqlite",
  "workerSummaries": {
    "enabled": true,
    "runtimeCommand": ["~/.local/bin/agent-consult"]
  },
  "conversationTitles": {
    "enabled": true,
    "runtimeCommand": ["~/.local/bin/agent-consult"]
  },
  "coordination": {
    "enabled": false,
    "pilotPaths": []
  },
  "sessions": {
    "restoreGraceHours": 1,
    "pressureSuspendAvailableMiB": 3072,
    "pressureSuspendIdleMinutes": 60
  },
  "structuredSessions": {
    "codex": {
      "enabled": true,
      "command": ["codex", "app-server"],
      "idleUnloadMinutes": 60,
      "env": {}
    },
    "claude": {
      "enabled": true,
      "command": ["claude"],
      "idleUnloadMinutes": 60,
      "env": {}
    }
  },
  "modelRouting": {
    "woPath": "/home/bryan/code/workflow_optimizer/.venv/bin/wo",
    "profilesTimeoutMs": 10000,
    "routeTimeoutMs": 8000
  },
  "security": {
    "passwordHash": "REPLACE_WITH_OUTPUT_FROM_NPM_RUN_AUTH_HASH",
    "sessionSecret": "REPLACE_WITH_64_PLUS_CHAR_RANDOM_HEX_SECRET",
    "cookieSecure": false,
    "sessionTtlHours": 168,
    "loginRateLimitMax": 10,
    "loginRateLimitWindowMs": 900000,
    "trustTailscaleHeaders": true,
    "tailscaleAllowedUserLogin": "single-user@example.com"
  },
  "providers": {
    "codex": {
      "enabled": true,
      "discoveryRoot": "~/.codex"
    },
    "claude": {
      "enabled": true,
      "discoveryRoot": "~/.claude"
    }
  },
  "projects": {
    "demo-web": {
      "active": true,
      "displayName": "Demo Web",
      "allowedLocalhostPorts": [3000, 5173],
      "tags": ["frontend", "primary"],
      "notes": "Main web surface"
    },
    "api-service": {
      "active": true,
      "displayName": "API Service",
      "allowedLocalhostPorts": [8080],
      "tags": ["backend"]
    },
    "archive": {
      "active": false,
      "displayName": "Archive"
    }
  }
}
